# --- Supabase Configuration ---
# ProspectEngine-YouTube Project
# Create a new Supabase project at https://supabase.com and paste credentials here
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# --- Backend / Edge Function Keys (server-side only — NEVER use VITE_ prefix) ---
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- AI & Intelligence ---
# Used for generating outreach messages and analyzing leads
VITE_OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# --- Data Sources (Scraping) ---
# Used to search Maps/Instagram/LinkedIn via Apify
VITE_APIFY_API_TOKEN=YOUR_APIFY_API_TOKEN

# --- Automation & Scheduling ---
CRON_SECRET=YOUR_CRON_SECRET
WEBHOOK_URL=https://webhook.n8n.io/YOUR_WEBHOOK_ID

# --- Client Specific Settings ---
VITE_CLIENT_ID=youtube_prospect_engine
VITE_CLIENT_NAME=ProspectEngine - YouTube
