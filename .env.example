# =====================================================
# DATABASE - Neon PostgreSQL (Vercel Integration)
# =====================================================
# Pooled connection (for most applications)
DATABASE_URL=postgresql://neondb_owner:PASSWORD@ENDPOINT-pooler.c-12.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require

# Non-pooled connection (for long-running queries)
DATABASE_URL_UNPOOLED=postgresql://neondb_owner:PASSWORD@ENDPOINT.c-12.us-east-1.aws.neon.tech/neondb?sslmode=require

# Vercel Postgres Format
POSTGRES_URL=postgresql://neondb_owner:PASSWORD@ENDPOINT-pooler.c-12.us-east-1.aws.neon.tech/neondb?channel_binding=require&sslmode=require
POSTGRES_PRISMA_URL=postgresql://neondb_owner:PASSWORD@ENDPOINT-pooler.c-12.us-east-1.aws.neon.tech/neondb?channel_binding=require&connect_timeout=15&sslmode=require
POSTGRES_USER=neondb_owner
POSTGRES_HOST=ENDPOINT-pooler.c-12.us-east-1.aws.neon.tech
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DATABASE=neondb

# =====================================================
# AUTHENTICATION & SECURITY
# =====================================================
# JWT Secret for token generation (CHANGE IN PRODUCTION!)
JWT_SECRET=your-super-secret-key-change-in-production

# =====================================================
# AI & INTELLIGENCE
# =====================================================
# OpenAI API Key (for lead analysis and outreach generation)
VITE_OPENAI_API_KEY=sk-your-openai-api-key

# =====================================================
# DATA SOURCES (Web Scraping)
# =====================================================
# Apify API Token (for Maps/Instagram/LinkedIn scraping)
VITE_APIFY_API_TOKEN=apify_api_token_here

# =====================================================
# AUTOMATION & SCHEDULING
# =====================================================
# Cron job secret for security
CRON_SECRET=your-cron-secret-key-here

# Webhook URL for n8n automation
WEBHOOK_URL=https://webhook.n8n.io/YOUR_WEBHOOK_ID

# =====================================================
# CLIENT CONFIGURATION
# =====================================================
# Application identification
VITE_CLIENT_ID=prospect_engine_youtube
VITE_CLIENT_NAME=ProspectEngine - YouTube

# Application URLs
VITE_APP_URL=http://localhost:5173
VITE_API_URL=http://localhost:5173/api

# =====================================================
# LOGGING & MONITORING
# =====================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info
DEBUG=false
